<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.j4va.kair.LoginController">
    <top>
        <fx:include fx:id="topBar" source="topbar.fxml" />
    </top>
    <center>
        <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f5f7;">
            <VBox alignment="CENTER" maxWidth="400" minWidth="400" prefWidth="400" spacing="15" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <VBox.margin>
                    <Insets bottom="40" left="40" right="40" top="40" />
                </VBox.margin>
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>

                <!-- Logo -->
                <HBox alignment="CENTER">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082)" text="ϰ KAIR" />
                </HBox>

                <!-- Title -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" text="Log in to continue" />

                <!-- Email Section -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #172b4d; -fx-font-weight: bold;" text="Email *" />
                    <TextField fx:id="emailField" promptText="Enter your email" style="-fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                </VBox>

                <!-- Remember Me -->
                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckBox" style="-fx-font-size: 14px;" text="Remember me" />
                    <Region prefWidth="5" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b778c;" text="ⓘ" />
                </HBox>

                <!-- Continue Button -->
                <Button fx:id="continueButton" maxWidth="Infinity" onAction="#handleContinue" style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 12px; -fx-font-size: 14px;" text="Continue" />

                <!-- Separator -->
                <Label style="-fx-font-size: 14px; -fx-text-fill: #6b778c; -fx-alignment: center;" text="Or continue with:" />

                <!-- Social Login Buttons -->
                <VBox spacing="10">
                    <Button fx:id="googleButton" maxWidth="Infinity" onAction="#handleGoogleLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4285f4; -fx-font-size: 16px;" text="G" />
                                <Label text="Google" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="microsoftButton" maxWidth="Infinity" onAction="#handleMicrosoftLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #00a1f1; -fx-font-size: 16px;" text="⊞">
                           <font>
                              <Font name="Marlett" size="12.0" />
                           </font></Label>
                                <Label text="Microsoft" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="appleButton" maxWidth="Infinity" onAction="#handleAppleLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #000000; -fx-font-size: 16px;" text="🍎" />
                                <Label text="Apple" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="slackButton" maxWidth="Infinity" onAction="#handleSlackLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4a154b; -fx-font-size: 16px;" text="⚡" />
                                <Label text="Slack" />
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Footer Links -->
                <HBox alignment="CENTER" spacing="10">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Can't log in?" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b778c;" text="•" />
                    <Label onMouseClicked="#handleCreateAccount" style="-fx-font-size: 14px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Create an account" />
                </HBox>

                <!-- Bottom Logo -->
                <VBox alignment="CENTER">
                    <VBox.margin>
                        <Insets top="20" />
                    </VBox.margin>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #6b778c;" text="▲ KAIR" />
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
