<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.j4va.kair.LoginController">
    <top>
        <fx:include fx:id="topBar" source="topbar.fxml" />
    </top>
    <center>
        <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f5f7;">
            <VBox alignment="CENTER" prefWidth="400" maxWidth="400" minWidth="400" spacing="15" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <VBox.margin>
                    <Insets top="40" bottom="40" left="40" right="40" />
                </VBox.margin>
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>

                <!-- Logo -->
                <HBox alignment="CENTER">
                    <Label text="▲ KAIR" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0052cc;" />
                </HBox>

                <!-- Title -->
                <Label text="Log in to continue" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" />

                <!-- Email Section -->
                <VBox spacing="8">
                    <Label text="Email *" style="-fx-font-size: 14px; -fx-text-fill: #172b4d; -fx-font-weight: bold;" />
                    <TextField fx:id="emailField" promptText="Enter your email" style="-fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                </VBox>

                <!-- Remember Me -->
                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckBox" text="Remember me" style="-fx-font-size: 14px;" />
                    <Region prefWidth="5" />
                    <Label text="ⓘ" style="-fx-font-size: 14px; -fx-text-fill: #6b778c;" />
                </HBox>

                <!-- Continue Button -->
                <Button fx:id="continueButton" maxWidth="Infinity" onAction="#handleContinue" text="Continue" style="-fx-background-color: #0052cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 12px; -fx-font-size: 14px;" />

                <!-- Separator -->
                <Label text="Or continue with:" style="-fx-font-size: 14px; -fx-text-fill: #6b778c; -fx-alignment: center;" />

                <!-- Social Login Buttons -->
                <VBox spacing="10">
                    <Button fx:id="googleButton" maxWidth="Infinity" onAction="#handleGoogleLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="G" style="-fx-font-weight: bold; -fx-text-fill: #4285f4; -fx-font-size: 16px;" />
                                <Label text="Google" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="microsoftButton" maxWidth="Infinity" onAction="#handleMicrosoftLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⊞" style="-fx-font-weight: bold; -fx-text-fill: #00a1f1; -fx-font-size: 16px;" />
                                <Label text="Microsoft" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="appleButton" maxWidth="Infinity" onAction="#handleAppleLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🍎" style="-fx-font-weight: bold; -fx-text-fill: #000000; -fx-font-size: 16px;" />
                                <Label text="Apple" />
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="slackButton" maxWidth="Infinity" onAction="#handleSlackLogin" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⚡" style="-fx-font-weight: bold; -fx-text-fill: #4a154b; -fx-font-size: 16px;" />
                                <Label text="Slack" />
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Footer Links -->
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Can't log in?" style="-fx-font-size: 14px; -fx-text-fill: #0052cc; -fx-underline: true;" />
                    <Label text="•" style="-fx-font-size: 14px; -fx-text-fill: #6b778c;" />
                    <Label text="Create an account" style="-fx-font-size: 14px; -fx-text-fill: #0052cc; -fx-underline: true;" onMouseClicked="#handleCreateAccount" />
                </HBox>

                <!-- Bottom Logo -->
                <VBox alignment="CENTER">
                    <VBox.margin>
                        <Insets top="20" />
                    </VBox.margin>
                    <Label text="▲ KAIR" style="-fx-font-size: 12px; -fx-text-fill: #6b778c;" />
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
