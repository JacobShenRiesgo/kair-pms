<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.j4va.kair.CreateProjectController"
            style="-fx-background-color: #f4f5f7;">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:15;">
            <Button text="⟵ Back" onAction="#handleBack" style="-fx-background-color:transparent; -fx-text-fill:#6a0dad; -fx-font-weight:bold;"/>
            <Label text="Create New Project" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#172b4d;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 30;">
            <GridPane hgap="12" vgap="12">
                <Label text="Project Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="420"/>

                <Label text="Assignee:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="assigneeBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="260"/>

                <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="statusBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>

                <Label text="Due Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dueDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Create" onAction="#handleCreate" style="-fx-background-color:#6a0dad; -fx-text-fill:white; -fx-padding:10 20; -fx-font-weight:bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
