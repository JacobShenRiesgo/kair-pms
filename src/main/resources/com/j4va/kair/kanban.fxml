<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="kanbanRoot"
            prefHeight="464" prefWidth="871"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.j4va.kair.KanbanController">

    <!-- ===================== TOP BAR ===================== -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>


            <Button text="⟵Back"
                    onAction="#goBack"
                    style="-fx-background-color: white;
                           -fx-text-fill: #4A148C;
                           -fx-font-weight: bold;"/>

            <Label text="Kanban Board"
                   style="-fx-text-fill: #4A148C;
                          -fx-font-size: 18;
                          -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ===================== MAIN BOARD ===================== -->
    <center>
        <HBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>


            <!-- ===================== TODO COLUMN ===================== -->
            <VBox fx:id="todoColumn" spacing="8" prefWidth="260">
                <Label text="To Do" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                <VBox fx:id="todoTasks" spacing="8"
                      style="-fx-background-color: #fafafa;
                             -fx-padding: 8;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;" />

                <Button text="+ Task" onAction="#openCreateTaskPopup"/>
            </VBox>

            <!-- ===================== IN PROGRESS ===================== -->
            <VBox fx:id="doingColumn" spacing="8" prefWidth="260">
                <Label text="In Progress" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                <VBox fx:id="doingTasks" spacing="8"
                      style="-fx-background-color: #fafafa;
                             -fx-padding: 8;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;" />

                <Button text="+ Task" onAction="#openCreateTaskPopup"/>
            </VBox>

            <!-- ===================== DONE ===================== -->
            <VBox fx:id="doneColumn" spacing="8" prefWidth="260">
                <Label text="Done" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                <VBox fx:id="doneTasks" spacing="8"
                      style="-fx-background-color: #fafafa;
                             -fx-padding: 8;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;" />

                <Button text="+ Task" onAction="#openCreateTaskPopup"/>
            </VBox>

        </HBox>
    </center>

</BorderPane>
