<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.j4va.kair.PasswordController">
    <top>
        <fx:include fx:id="topBar" source="topbar.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: #f4f5f7;">
            <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f5f7; -fx-min-height: 600px;">
                <VBox alignment="CENTER" prefWidth="400" maxWidth="400" minWidth="400" spacing="12" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <VBox.margin>
                        <Insets top="30" bottom="30" left="40" right="40" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="25" left="35" right="35" top="25" />
                    </padding>

                    <!-- Logo -->
                    <HBox alignment="CENTER">
                        <Label text="▲ ATLASSIAN" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0052cc;" />
                    </HBox>

                    <!-- Title -->
                    <Label text="Create password" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" />

                    <!-- Email Display -->
                    <Label fx:id="emailLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: #6b778c; -fx-alignment: center;" />

                    <!-- Password Section -->
                    <VBox spacing="6">
                        <Label text="Create password" style="-fx-font-size: 14px; -fx-text-fill: #172b4d; -fx-font-weight: normal;" />
                        <PasswordField fx:id="passwordField" promptText="Enter password" style="-fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                    </VBox>

                    <!-- Password Requirements - More compact -->
                    <VBox spacing="3" alignment="CENTER_LEFT">
                        <VBox.margin>
                            <Insets top="5" bottom="5" />
                        </VBox.margin>
                        <Label text="Your password must have:" style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" />
                        <Label fx:id="lengthRequirement" text="• At least 8 characters" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" />
                        <Label fx:id="uppercaseRequirement" text="• At least 1 uppercase letter" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" />
                        <Label fx:id="lowercaseRequirement" text="• At least 1 lowercase letter" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" />
                        <Label fx:id="numberRequirement" text="• At least 1 number" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" />
                    </VBox>

                    <!-- Create Account Button -->
                    <Button fx:id="createAccountButton" maxWidth="Infinity" onAction="#handleCreateAccount" text="Create account" style="-fx-background-color: #0052cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;" />

                    <!-- Footer Links -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" style="-fx-font-size: 13px; -fx-text-fill: #6b778c;" />
                        <Label text="Log in" style="-fx-font-size: 13px; -fx-text-fill: #0052cc; -fx-underline: true;" onMouseClicked="#handleBackToLogin" />
                    </HBox>

                    <!-- Bottom Logo -->
                    <VBox alignment="CENTER">
                        <VBox.margin>
                            <Insets top="15" />
                        </VBox.margin>
                        <Label text="▲ ATLASSIAN" style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
