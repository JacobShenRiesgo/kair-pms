<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.j4va.kair.PasswordController">
    <top>
        <fx:include fx:id="topBar" source="topbar.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f5f7;" vbarPolicy="AS_NEEDED">
            <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f5f7; -fx-min-height: 600px;">
                <VBox alignment="CENTER" maxWidth="400" minWidth="400" prefWidth="400" spacing="12" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <VBox.margin>
                        <Insets bottom="30" left="40" right="40" top="30" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="25" left="35" right="35" top="25" />
                    </padding>

                    <!-- Logo -->
                    <HBox alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082);" text="▲ KAIR" />
                    </HBox>

                    <!-- Title -->
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" text="Create password" />

                    <!-- Email Display -->
                    <Label fx:id="emailLabel" style="-fx-font-size: 14px; -fx-text-fill: #6b778c; -fx-alignment: center;" text="" />

                    <!-- Password Section -->
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #172b4d; -fx-font-weight: normal;" text="Create password" />
                        <PasswordField fx:id="passwordField" promptText="Enter password" style="-fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                    </VBox>

                    <!-- Password Requirements - More compact -->
                    <VBox alignment="CENTER_LEFT" spacing="3">
                        <VBox.margin>
                            <Insets bottom="5" top="5" />
                        </VBox.margin>
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="Your password must have:" />
                        <Label fx:id="lengthRequirement" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" text="• At least 8 characters" />
                        <Label fx:id="uppercaseRequirement" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" text="• At least 1 uppercase letter" />
                        <Label fx:id="lowercaseRequirement" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" text="• At least 1 lowercase letter" />
                        <Label fx:id="numberRequirement" style="-fx-font-size: 10px; -fx-text-fill: #de350b;" text="• At least 1 number" />
                    </VBox>

                    <!-- Create Account Button -->
                    <Button fx:id="createAccountButton" maxWidth="Infinity" onAction="#handleCreateAccount" style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;" text="Create account" />

                    <!-- Footer Links -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6b778c;" text="Already have an account?" />
                        <Label onMouseClicked="#handleBackToLogin" style="-fx-font-size: 13px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Log in" />
                    </HBox>

                    <!-- Bottom Logo -->
                    <VBox alignment="CENTER">
                        <VBox.margin>
                            <Insets top="15" />
                        </VBox.margin>
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="▲ Kair" />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
