<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.j4va.kair.SignupController">
    <top>
        <fx:include fx:id="topBar" source="topbar.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f5f7;" vbarPolicy="AS_NEEDED">
            <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f5f7; -fx-min-height: 600px;">
                <VBox alignment="CENTER" maxWidth="400" minWidth="400" prefWidth="400" spacing="12" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <VBox.margin>
                        <Insets bottom="30" left="40" right="40" top="30" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="25" left="35" right="35" top="25" />
                    </padding>

                    <!-- Logo -->
                    <HBox alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082);" text="▲ KAIR" />
                    </HBox>

                    <!-- Title -->
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" text="Sign up to continue" />

                    <!-- Email Section -->
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #172b4d; -fx-font-weight: normal;" text="Enter email address" />
                        <TextField fx:id="emailField" promptText="Enter your email" style="-fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 14px;" />
                    </VBox>

                    <!-- Terms and Privacy - More compact -->
                    <VBox alignment="CENTER" spacing="3">
                        <VBox.margin>
                            <Insets bottom="5" top="5" />
                        </VBox.margin>
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="By signing up, I accept the Kair Cloud Terms of" />
                        <HBox alignment="CENTER" spacing="3">
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Service" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="and acknowledge the" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Privacy Policy" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="." />
                        </HBox>
                    </VBox>

                    <!-- Sign Up Button -->
                    <Button fx:id="signUpButton" maxWidth="Infinity" onAction="#handleSignUp" style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #6a0dad, #4b0082); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 10px; -fx-font-size: 14px;" text="Sign up" />

                    <!-- Separator -->
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b778c; -fx-alignment: center;" text="Or continue with:" />

                    <!-- Social Login Buttons - Reduced spacing -->
                    <VBox spacing="8">
                        <Button fx:id="googleButton" maxWidth="Infinity" onAction="#handleGoogleSignup" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 13px;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4285f4; -fx-font-size: 14px;" text="G" />
                                    <Label text="Google" />
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="microsoftButton" maxWidth="Infinity" onAction="#handleMicrosoftSignup" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 13px;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #00a1f1; -fx-font-size: 14px;" text="⊞" />
                                    <Label text="Microsoft" />
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="appleButton" maxWidth="Infinity" onAction="#handleAppleSignup" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 13px;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #000000; -fx-font-size: 14px;" text="🍎" />
                                    <Label text="Apple" />
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="slackButton" maxWidth="Infinity" onAction="#handleSlackSignup" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px; -fx-font-size: 13px;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a154b; -fx-font-size: 14px;" text="⚡" />
                                    <Label text="Slack" />
                                </HBox>
                            </graphic>
                        </Button>
                    </VBox>

                    <!-- Footer Links -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6b778c;" text="Already have an Kair account?" />
                        <Label onMouseClicked="#handleBackToLogin" style="-fx-font-size: 13px; -fx-text-fill: #0052cc; -fx-underline: true;" text="Log in" />
                    </HBox>

                    <!-- Bottom Logo -->
                    <VBox alignment="CENTER" spacing="2">
                        <VBox.margin>
                            <Insets top="15" />
                        </VBox.margin>
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6b778c;" text="▲ Kair" />
                        <Label style="-fx-font-size: 9px; -fx-text-fill: #6b778c; -fx-alignment: center;" text="One account for Jira, Confluence, Trello and more." />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>