<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.j4va.kair.ViewProjectsController">

    <!-- Top Bar -->
    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-background-color: #f4f5f7; -fx-padding: 30px;">

            <!-- Back Button -->
            <Button fx:id="backButton" text="Back"  style="-fx-background-color: #6a0dad; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"
                   text="All Projects"/>
            <Label style="-fx-font-size: 16px; -fx-text-fill: #6b778c;"
                   text="Browse and manage all your projects"/>

            <!-- Projects Table/Card Area -->
            <VBox fx:id="projectsContainer" spacing="15" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px;
                                  -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

                <HBox spacing="15">
                    <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6px;
                                          -fx-background-radius: 6px; -fx-padding: 15px; -fx-min-width: 200px;">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Project Name"/>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6a0dad;" text="Website Redesign"/>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #28a745;" text="Status: Active"/>
                    </VBox>

                    <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6px;
                                          -fx-background-radius: 6px; -fx-padding: 15px; -fx-min-width: 200px;">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Project Name"/>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6a0dad;" text="Mobile App Dev"/>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #fd7e14;" text="Status: In Progress"/>
                    </VBox>
                </HBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>
