<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.j4va.kair.TeamDashboardController">

    <!-- Top Bar -->
    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-background-color: #f4f5f7; -fx-padding: 30px;">

            <!-- Back Button -->
            <Button fx:id="backButton" text="Back"
                    style="-fx-background-color: #6a0dad; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"
                   text="Team Dashboard"/>
            <Label style="-fx-font-size: 16px; -fx-text-fill: #6b778c;"
                   text="Overview of team members and their tasks"/>

            <!-- Team Summary Cards -->
            <HBox spacing="15">
                <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6px;
                                          -fx-background-radius: 6px; -fx-padding: 15px; -fx-min-width: 200px;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Total Members"/>
                    <Label fx:id="totalMembersLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #fd7e14;" text="0"/>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6px;
                                          -fx-background-radius: 6px; -fx-padding: 15px; -fx-min-width: 200px;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Active Tasks"/>
                    <Label fx:id="activeTasksLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="0"/>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 6px;
                                          -fx-background-radius: 6px; -fx-padding: 15px; -fx-min-width: 200px;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Completed Tasks"/>
                    <Label fx:id="completedTasksLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="0"/>
                </VBox>
            </HBox>

            <!-- Team Member List -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8px;
                                      -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #172b4d;" text="Team Members"/>

                <ListView fx:id="teamMembersList" prefHeight="200" style="-fx-background-color: #f8f9fa;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
